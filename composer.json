{
    "require": {
        "php": "^8.1 || ^8.2 || ^8.3",
        "guzzlehttp/guzzle": "*",
        "lucatume/wp-browser": "^3.2",
        "codeception/codeception": "4.2.2",
        "symfony/yaml": "^5.4"
    },
    "require-dev": {
        "codeception/module-db": "^1.0",
        "codeception/module-webdriver": "^1.0",
        "codeception/module-asserts": "^1.2",
        "codeception/module-cli": "^1.0",
        "codeception/module-phpbrowser": "^1.0",
        "codeception/module-rest": "^1.2",
        "behat/behat": "^3.13",
        "phpunit/php-code-coverage": "*",
        "php-stubs/wordpress-stubs": "^6.0"
    },
    "config": {
        "bin-dir": "bin",
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "autoload": {
        "classmap": [
            "src/"
        ],
        "psr-4": {
            "Aiplugin5055\\": "src/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "cp vendor/behat/gherkin/i18n.php vendor/i18n.php"
        ],
        "post-update-cmd": [
            "cp vendor/behat/gherkin/i18n.php vendor/i18n.php"
        ],
        "test": [
            "@test-phpunit",
            "@test-wpunit"
        ],
        "test-all": [
            "@test-phpunit",
            "@test-wpunit",
            "@test-acceptance"
        ],
        "test-phpunit": "bin/codecept run phpunit",
        "test-wpunit": "bin/codecept run wpunit",
        "test-acceptance": "bash .devenv/start-chromedriver.sh && bin/codecept run acceptance",
        "test-clean": "rm -rf tests/_output/*",
        "destroy-instance": "php destroy-testing-instance.php"
    }
}
